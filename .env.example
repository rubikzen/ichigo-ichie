# Public app
NEXT_PUBLIC_SITE_URL=https://www.ichigoichiematcha.fr

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional compatibility fallback if your project still uses the legacy name:
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional emails (Resend)
RESEND_API_KEY=
EMAIL_FROM=Ichigo Ichie <contact@ichigoichiematcha.fr>
CONTACT_NOTIFICATION_EMAIL=
ORDER_NOTIFICATION_EMAIL=

# Commerce / legal
# Used only as a fallback when site_settings.terms_version is missing.
TERMS_VERSION=2026-08-12-v1

# Public API protection
# Use a long random value in Vercel. If omitted, the server secret key is used as the hash salt.
RATE_LIMIT_SECRET=
# Emergency switch only; normally keep false.
RATE_LIMIT_DISABLED=false
