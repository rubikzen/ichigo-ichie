import type { Metadata } from "next";
import "./globals.css";
import { Providers } from "@/components/Providers";
import { SiteHeader } from "@/components/SiteHeader";
import { getSiteSettings } from "@/lib/settings";

export const metadata: Metadata = {
  title: "Ichigo Ichie — Maison de Matcha à Nice",
  description: "Matcha japonais, boissons et douceurs à Nice. Menu et commande en ligne.",
};

export default async function RootLayout({ children }: Readonly<{ children: React.ReactNode }>) {
  const settings = await getSiteSettings();
  return (
    <html lang="fr">
      <body>
        <Providers>
          <SiteHeader announcementFr={settings.announcement_fr} announcementEn={settings.announcement_en} />
          <main>{children}</main>
          <footer className="site-footer">
            <div><strong>ICHIGO ICHIE</strong><p>Un moment. Une tasse. Des souvenirs.</p></div>
            <div><p>14 rue Centrale · Vieux Nice</p><p>{settings.opening_hours ? `Ouvert · ${settings.opening_hours}` : ""}</p><p>© {new Date().getFullYear()} Ichigo Ichie</p></div>
          </footer>
        </Providers>
      </body>
    </html>
  );
}
